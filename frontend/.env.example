# =============================================================================
# TeraPlayer Frontend --- Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables prefixed with REACT_APP_ are available at build time.
# =============================================================================

# --- Backend API URL (Required) ----------------------------------------------
# The full URL of your deployed backend server, WITHOUT trailing slash.
# Examples:
#   https://teraplayer-api.onrender.com
#   http://localhost:8001
REACT_APP_BACKEND_URL=http://localhost:8001

# --- Google Identity Services (Optional, for Google Sign-In) -------------------
# Public Google Client ID for rendering the Google Sign-In button.
# Configure this value in your Render environment (no secret needed here).
REACT_APP_GOOGLE_CLIENT_ID=
