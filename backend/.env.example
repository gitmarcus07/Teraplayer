# =============================================================================
# TeraPlayer Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Deployment targets: Render, Railway, or any platform that supports
# FastAPI / Uvicorn ASGI applications.
# =============================================================================

# --- MongoDB (Required) ------------------------------------------------------
# Connection string for your MongoDB instance.
# Local:    mongodb://localhost:27017
# Atlas:    mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Database name (default: teraplayer)
DB_NAME=teraplayer

# --- CORS (Required) ---------------------------------------------------------
# Comma-separated list of allowed origins for CORS. MUST list only TeraPlayer
# frontend origins — never "*". Credentialed admin requests echo the exact
# requesting origin and require credentials, so a wildcard would be unsafe.
# Examples:
#   https://teraplayer.in,https://www.teraplayer.in (production)
#   http://localhost:3000 (for development)
CORS_ORIGINS=https://teraplayer.in,https://www.teraplayer.in

# --- TeraBox ndus cookie (OPTIONAL - legacy native/Playwright fallback) ------
# Your TeraBox ndus cookie as a JSON object {"ndus": "..."}.
# Only needed for the native and Playwright extractors. NOT required when using
# the xAPIverse API (XAPIVERSE_API_KEY), which is the recommended production path.
# Instructions:
#   1. Open Chrome devtools -> Application -> Cookies -> www.1024tera.com
#   2. Copy the value of the "ndus" cookie
#   3. Set it below as a JSON object
# Example: COOKIE_JSON={"ndus":"abc123def456"}
COOKIE_JSON=

# Alternative: raw ndus value (if COOKIE_JSON is not set)
TERABOX_NDUS=

# --- Cloudflare Worker (Optional) -------------------------------------------
# URL of your deployed Cloudflare Worker for extraction.
# See cloudflare-worker/ for deployment instructions.
TERABOX_WORKER_URL=

# --- xAPIverse (PRIMARY TeraBox extractor) ----------------------------------
# API key for https://xapiverse.com/api/terabox. This is the primary/reliable
# production extraction path and does NOT require a personal TeraBox cookie.
# Server-side only; never exposed to the frontend or client code.
# SHADOW MODE: keep set while trialling the self-API. New code defaults to
# ALLOW_XAPIVERSE_FALLBACK=true so paid path still rescues failures.
XAPIVERSE_API_KEY=
ALLOW_XAPIVERSE_FALLBACK=true

# --- Self-hosted TeraBox compat API (additive, shadow mode) ------------------
# Drop-in replacement for xAPIverse. New routes only:
#   POST /api/terabox        -> xAPIverse-compatible JSON (uses free extractors)
#   GET  /api/fast_stream    -> proxied HLS playlist (signed token)
#   GET  /api/terabox/health -> safe diagnostics (no secrets)
# Frontend trials it via REACT_APP_USE_SELF_API=true, falls back to /preview.
SELF_API_ENABLED=true
FAST_STREAM_TTL=21600

# --- TeraBox cookie pool (OPTIONAL, $0) -------------------------------------
# One or more free ndus cookies as JSON list. The pool round-robins and
# temporarily blacklists cookies that hit errno 400141 / need-verify.
# Example: COOKIE_POOL_JSON=["ndus=AAA", "ndus=BBB"]
# Legacy COOKIE_JSON / TERABOX_NDUS still work as fallback (lowest priority).
COOKIE_POOL_JSON=

# --- Browser-extension extraction bridge (Optional but recommended) ---------
# HMAC secret used to bind browser-extension submit tokens to their jobs.
# Never share this value; it is read server-side only and never exposed to
# clients. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, an ephemeral in-process secret is used (tokens do not survive restarts).
EXTENSION_HMAC_SECRET=

# --- Server Settings (Optional) ---------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Port for the uvicorn server (Render/Railway set this automatically via $PORT)
PORT=8001

# Number of uvicorn workers (default: 1)
# Increase for production, e.g. WEB_CONCURRENCY=4
WEB_CONCURRENCY=1

# --- Rate Limiting (Optional) -----------------------------------------------
# Rate limit: max requests per window per IP (default: 60)
RATE_LIMIT_MAX=60

# Rate limit window in seconds (default: 60)
RATE_LIMIT_WINDOW=60

# --- Auth (Built-in TeraPlayer authentication) --------------------------------
# TeraPlayer uses native email/password authentication with bcrypt hashing.
# No external auth provider is required.

# Google Identity Services (optional, for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin (premium control center) ------------------------------------------
# Bootstrap credentials for the initial SUPER_ADMIN. Only used the very first
# time the backend starts with an empty `admins` collection (MongoDB). If these
# are missing, the backend logs a warning and you can still create the first
# super admin by setting them and restarting.
#   - ADMIN_EMAIL:   email of the initial super admin
#   - ADMIN_PASSWORD: password (min 8 chars). Server-side only; never client-side.
# The admin login lives at /admin on the frontend, served over https.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Google Search Console (Optional) -----------------------------------------
# Service account credentials for Google Search Console API access.
# 1. Create a service account in Google Cloud Console
# 2. Enable "Google Search Console API"
# 3. Grant service account access to your Search Console property (Owner/Full)
# 4. Download JSON key and set as single-line JSON in GOOGLE_SEARCH_CONSOLE_CREDENTIALS
# Example: GOOGLE_SEARCH_CONSOLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
