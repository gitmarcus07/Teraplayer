# =============================================================================
# TeraPlayer Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Deployment targets: Render, Railway, or any platform that supports
# FastAPI / Uvicorn ASGI applications.
# =============================================================================

# --- MongoDB (Required) ------------------------------------------------------
# Connection string for your MongoDB instance.
# Local:    mongodb://localhost:27017
# Atlas:    mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Database name (default: teraplayer)
DB_NAME=teraplayer

# --- CORS (Required) ---------------------------------------------------------
# Comma-separated list of allowed origins for CORS.
# In production, list your frontend domain(s) explicitly.
# Examples:
#   https://your-app.vercel.app
#   https://your-app.netlify.app
#   http://localhost:3000 (for development)
CORS_ORIGINS=https://your-frontend.vercel.app

# --- TeraBox ndus cookie (OPTIONAL - legacy native/Playwright fallback) ------
# Your TeraBox ndus cookie as a JSON object {"ndus": "..."}.
# Only needed for the native and Playwright extractors. NOT required when using
# the xAPIverse API (XAPIVERSE_API_KEY), which is the recommended production path.
# Instructions:
#   1. Open Chrome devtools -> Application -> Cookies -> www.1024tera.com
#   2. Copy the value of the "ndus" cookie
#   3. Set it below as a JSON object
# Example: COOKIE_JSON={"ndus":"abc123def456"}
COOKIE_JSON=

# Alternative: raw ndus value (if COOKIE_JSON is not set)
TERABOX_NDUS=

# --- Cloudflare Worker (Optional) -------------------------------------------
# URL of your deployed Cloudflare Worker for extraction.
# See cloudflare-worker/ for deployment instructions.
TERABOX_WORKER_URL=

# --- xAPIverse (PRIMARY TeraBox extractor) ----------------------------------
# API key for https://xapiverse.com/api/terabox. This is the primary/reliable
# production extraction path and does NOT require a personal TeraBox cookie.
# Server-side only; never exposed to the frontend or client code.
XAPIVERSE_API_KEY=

# --- Browser-extension extraction bridge (Optional but recommended) ---------
# HMAC secret used to bind browser-extension submit tokens to their jobs.
# Never share this value; it is read server-side only and never exposed to
# clients. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, an ephemeral in-process secret is used (tokens do not survive restarts).
EXTENSION_HMAC_SECRET=

# --- Server Settings (Optional) ---------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Port for the uvicorn server (Render/Railway set this automatically via $PORT)
PORT=8001

# Number of uvicorn workers (default: 1)
# Increase for production, e.g. WEB_CONCURRENCY=4
WEB_CONCURRENCY=1

# --- Rate Limiting (Optional) -----------------------------------------------
# Rate limit: max requests per window per IP (default: 60)
RATE_LIMIT_MAX=60

# Rate limit window in seconds (default: 60)
RATE_LIMIT_WINDOW=60

# --- Auth (Built-in TeraPlayer authentication) --------------------------------
# TeraPlayer uses native email/password authentication with bcrypt hashing.
# No external auth provider is required.

# Google Identity Services (optional, for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
